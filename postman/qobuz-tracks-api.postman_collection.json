          "name": "getFileUrl",
          "item": [
            {
              "name": "Generate streaming or download URL for a track",
              "id": "0c595c2f-0cb0-447a-acb9-074e90ffd01b",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "auth": {
                  "type": "apikey",
                  "apikey": [
                    {
                      "key": "key",
