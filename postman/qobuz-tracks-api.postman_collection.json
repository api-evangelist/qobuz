                    }
                  ]
                },
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/track/getFileUrl?app_id=<string>&track_id=<integer>&format_id=6&intent=stream&request_ts=<integer>&request_sig=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "track",
                    "getFileUrl"
                  ],
                  "query": [
                    {
                      "description": "(Required) Your Qobuz application identifier",
                      "key": "app_id",
                      "value": "<string>"
                    },
                    {
                      "description": "(Required) Qobuz track identifier",
                      "key": "track_id",
                      "value": "<integer>"
                    },
                    {
                      "description": "(Required) Audio format code (5=MP3-320, 6=FLAC-CD, 7=FLAC-HiRes-96kHz, 27=FLAC-HiRes-192kHz)",
                      "key": "format_id",
                      "value": "6"
                    },
                    {
                      "description": "(Required) Intended use \u2014 stream or download",
                      "key": "intent",
                      "value": "stream"
                    },
                    {
                      "description": "(Required) Current Unix timestamp used in signature",
                      "key": "request_ts",
                      "value": "<integer>"
                    },
                    {
                      "description": "(Required) MD5 signature authenticating the request",
                      "key": "request_sig",
                      "value": "<string>"
                    }
                  ]
                },
                "description": "Generates an authenticated streaming or download URL for a track in the specified audio format. Requires a valid user_auth_token (X-User-Auth-Token header) and a signed request.\nThe request_sig is computed as:\n  MD5(intent + \"trackid\" + track_id + \"formatid\" + format_id + request_ts + app_secret)\n\nFormat IDs:\n  5  = MP3 320 kbps CBR\n  6  = FLAC 16-bit/44.1 kHz (CD quality)\n  7  = FLAC 24-bit/96 kHz (Hi-Res)\n  27 = FLAC 24-bit/192 kHz (Hi-Res)"
              },
